   "source": [
    "3. Write a program to reverse a string without using slicing ([::-1]) or built-in functions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e998d3c6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Reversed string: madam\n"
     ]
    }
   ],
   "source": [
    "string = input(\"Enter a string: \")\n",
    "\n",
    "reverse = \"\"\n",
    "\n",
    "for ch in string:\n",
    "    reverse = ch + reverse\n",
    "\n",
    "print(\"Reversed string:\", reverse)"
   ]
  }
 ],
