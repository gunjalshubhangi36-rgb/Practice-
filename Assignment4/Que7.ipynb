   "source": [
    "7. Write a program to capitalize the first letter of every word without using the title()\n",
    "method.\n",
    "- Input: welcome to python\n",
    "- Output: Welcome To Python"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "dccbe53c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shubhangi Santosh Gunjal "
     ]
    }
   ],
   "source": [
    "Str1 = input(\"Enter string\")\n",
    "\n",
    "words = Str1.split()\n",
    "\n",
    "\n",
    "for word in words:\n",
    "    print(word.capitalize(), end = \" \")\n",
    "\n",
    "\n"
   ]
  }
 ],
