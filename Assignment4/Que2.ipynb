   "source": [
    "2. Write a program to check whether a given string is a Palindrome.\n",
    "- Input: madam\n",
    "- Output : Palindrome"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "61748f91",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "String is not palindrom\n"
     ]
    }
   ],
   "source": [
    "str1 = input(\"Enter String\")\n",
    "\n",
    "str2 = reversed(str1)\n",
    "\n",
    "if str1 == str2:\n",
    "    print(\"String is palindrom\")\n",
    "else:\n",
    "    print(\"String is not palindrom\")"
   ]
  }
 ],
