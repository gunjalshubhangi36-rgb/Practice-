   "source": [
    "2. Write a program to remove all duplicate elements from a list using a set."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "27c89fdf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original list : {2, 3, 4, 6, 9}\n",
      "After removing duplicate : [2, 3, 4, 6, 9]\n"
     ]
    }
   ],
   "source": [
    "list1 = {2, 3, 4, 2, 9 ,3 ,6}\n",
    "print(\"Original list :\", list1)\n",
    "unique = list(set(list1))\n",
    "print(\"After removing duplicate :\", unique)"
   ]
  }
