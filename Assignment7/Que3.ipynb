   "source": [
    "3. Write a program to find all common elements between two lists using sets."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4045bae3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Common element in the Set :\n",
      "Common element in the Set : {2, 3, 6, 7}\n"
     ]
    }
   ],
   "source": [
    "set1 = {2, 3, 4, 7, 9 ,4 ,6}\n",
    "set2 = {2, 8, 6, 0, 1, 3, 7}\n",
    "\n",
    "\n",
    "common = set1.intersection(set2)\n",
    "\n",
    "print(\"Common element in the Set :\", common)\n",
    "\n"
   ]
  }
