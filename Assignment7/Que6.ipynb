   "source": [
    "6. Write a program to create a new set containing only the even numbers from a given\n",
    "set."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "6bd9b667",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Set 1:  {4, 6, 7, 8, 9}\n",
      "Set containing only even numbers : {8, 4, 6}\n"
     ]
    }
   ],
   "source": [
    "set1 = {7, 9, 6, 4, 8}\n",
    "print(\"Set 1: \", set1)\n",
    "\n",
    "res = set()\n",
    "\n",
    "for i in set1:\n",
    "    if i % 2 == 0:\n",
    "        res.add(i)\n",
    "print(\"Set containing only even numbers :\", res)"
   ]
  }
 ],
