   "source": [
    "1. Write a program to find the union of two sets without using the union() method."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "767e2b6c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Union:  {0, 1, 2, 3, 4, 6, 7, 8, 9}\n"
     ]
    }
   ],
   "source": [
    "set1 = {2, 3, 4, 7, 9 ,4 ,6}\n",
    "set2 = {2, 8, 6, 0, 1, 3, 7}\n",
    "\n",
    "union = set1\n",
    "\n",
    "for i in set2:\n",
    "    if i not in union:\n",
    "        union.add(i)\n",
    "\n",
    "print(\"Union: \", union)"
   ]
  }
 ],
