   "source": [
    "7. Write a program to merge three sets into a single set containing only unique\n",
    "elements."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{0, 1, 2, 3, 5, 6, 7, 8, 9}\n"
     ]
    }
   ],
   "source": [
    "set1 = {2, 7, 9, 5}\n",
    "set2 = {6, 8, 0, 1}\n",
    "set3 = {7, 8, 5, 3}\n",
    "\n",
    "newset = set1.copy()\n",
    "\n",
    "for i in set2:\n",
    "    newset.add(i)\n",
    "\n",
    "for i in set3:\n",
    "    newset.add(i)\n",
    "\n",
    "print(newset)\n",
    "\n"
   ]
  }
 ],
