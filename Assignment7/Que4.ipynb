   ],
   "source": [
    "list1 = [2, 3, 4, 7, 9 ,4 ,6]\n",
    "list2 = [2, 8, 6, 0, 1, 3, 7]\n",
    "\n",
    "union = set(list1)\n",
    "\n",
    "print(\"Unique element : \", union)\n",
    "print(\"Count of unique element: \", len(union))\n",
    "\n"
   ]
