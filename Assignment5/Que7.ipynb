   "source": [
    "7. Write a program to reverse a list without using the reverse() method or slicing ([::-1]).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "27696e2d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Reversed List: [4, 3, 2, 1]\n"
     ]
    }
   ],
   "source": [
    "listOne = [1,2,3,4]\n",
    "count = 0\n",
    "\n",
    "reverse = []\n",
    "\n",
    "for i in listOne:\n",
    "    reverse = [i] + reverse\n",
    "\n",
    "print(\"Reversed List:\", reverse)\n",
    "\n",
    "\n"
   ]
  }
