   "source": [
    "6. Write a program to count the frequency of every element in a list.\n",
    "- Input:\n",
    "- [1,2,3,2,1,4,1]\n",
    "-\n",
    "- Output:\n",
    "- 1 -> 3\n",
    "- 2 -> 2\n",
    "- 3 -> 1\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "b12c5c5f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1 : 3\n",
      "2 : 2\n",
      "3 : 1\n",
      "4 : 1\n"
     ]
    }
   ],
   "source": [
    "listOne = [1,2,3,2,1,4,1]\n",
    "\n",
    "for i in set(listOne):\n",
    "    print(i,\":\",listOne.count(i))\n",
    "\n"
   ]
  }
 ],
