   "source": [
    "4. Write a program to find the second largest element in a list.\n",
    "- Input:\n",
    "- [12,45,67,89,54]\n",
    "-\n",
    "- Output:\n",
    "- 67"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "1ccab84f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[12, 45, 54, 67, 89]\n",
      "Second large number of the list : 67\n"
     ]
    }
   ],
   "source": [
    "listOne = [12,45,67,89,54]\n",
    "\n",
    "list1 = sorted(listOne)\n",
    "print(list1)\n",
    "\n",
    "print(\"Second large number of the list :\", list1[-2])\n",
    "\n"
   ]
  }
 ],
