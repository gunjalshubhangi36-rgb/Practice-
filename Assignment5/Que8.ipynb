   "source": [
    "8. Write a program to check whether a list is a Palindrome.\n",
    "- Input:\n",
    "- [1,2,3,2,1]\n",
    "-\n",
    "- Output:\n",
    "- Palindrome"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "4932414f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "list is palindrom\n"
     ]
    }
   ],
   "source": [
    "listOne = [1,2,3,2,1]\n",
    "\n",
    "listTwo = list(reversed(listOne))\n",
    "\n",
    "if listOne == listTwo:\n",
    "    print(\"list is palindrom\")\n",
    "else:\n",
    "    print(\"list is not palindrom\")"
   ]
  }
 ],
