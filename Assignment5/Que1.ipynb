   "source": [
    "1. Write a program to count the number of even and odd numbers in a list.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "c6567878",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "count of even number : 3\n",
      "count of odd number : 1\n"
     ]
    }
   ],
   "source": [
    "list = [2,4,6,7]\n",
    "\n",
    "even = 0\n",
    "odd = 0\n",
    "\n",
    "for i in list:\n",
    "    if i % 2 == 0:\n",
    "        even += 1\n",
    "    else:\n",
    "        odd += 1\n",
    "print(\"count of even number :\", even)\n",
    "print(\"count of odd number :\", odd)\n"
   ]
  }
 ],
