   "id": "ba4e5920",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Key exists\n"
     ]
    }
   ],
   "source": [
    "Dict1 = {'a':10, 'b':20, 'c':10, 'd':30}\n",
    "\n",
    "key = input('Enter key: ')\n",
    "\n",
    "if key in Dict1:\n",
    "    print('Key exists')\n",
    "else:\n",
    "    print('Key does not exist')\n",
    "        "
   ]
