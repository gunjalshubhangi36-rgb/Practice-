   "source": [
    "3. Write a program to find the key having the maximum value in a dictionary.\n",
    "- Input:\n",
    "- {'A':85, 'B':92, 'C':78}\n",
    "-\n",
    "- Output:\n",
    "- B"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "3595e782",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{'A': 85, 'B': 92, 'C': 78}\n",
      "The key having the maximum value in a dictionary is :\n",
      "B\n"
     ]
    }
   ],
   "source": [
    "Dict1 = {'A':85, 'B':92, 'C':78}\n",
    "print(Dict1)\n",
    "\n",
    "print(\"The key having the maximum value in a dictionary is :\")\n",
    "\n",
    "print(max(Dict1, key = Dict1.get))\n",
    "\n"
   ]
  }
 ],
