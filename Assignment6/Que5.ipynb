   "source": [
    "5. Write a program to remove duplicate elements from a tuple while preserving the\n",
    "original order."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "b1e592df",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original Tuple : (2, 3, 4, 2, 9, 3, 6)\n",
      "After removing duplicate : (2, 3, 4, 9, 6)\n"
     ]
    }
   ],
   "source": [
    "tup1 = (2, 3, 4, 2, 9 ,3 ,6)\n",
    "print(\"Original Tuple :\", tup1)\n",
    "\n",
    "new = ()\n",
    "for i in tup1:\n",
    "    if i not in new:\n",
    "        new += (i, )\n",
    "print(\"After removing duplicate :\", new)\n",
    "\n"
   ]
  }
 ],
