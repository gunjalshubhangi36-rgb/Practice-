   "source": [
    "8. Write a program to find the union of two tuples (unique elements only)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "36b55ebe",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Union:  (2, 3, 4, 7, 9, 4, 6, 8, 0, 1)\n"
     ]
    }
   ],
   "source": [
    "tup1 = (2, 3, 4, 7, 9 ,4 ,6)\n",
    "tup2 = (2, 8, 6, 0, 1, 3, 7)\n",
    "\n",
    "union = tup1\n",
    "\n",
    "for i in tup2:\n",
    "    if i not in union:\n",
    "        union += (i, )\n",
    "\n",
    "print(\"Union: \", union)\n",
    "\n"
   ]
  }
 ],
