   "source": [
    "3. Write a program to find all common elements between two tuples."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1167149f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Common element in the tuple :\n",
      "2\n",
      "3\n",
      "6\n",
      "7\n"
     ]
    }
   ],
   "source": [
    "tup1 = (2, 3, 4, 7, 9 ,4 ,6)\n",
    "tup2 = (2, 8, 6, 0, 1, 3, 7)\n",
    "\n",
    "print(\"Common element in the tuple :\")\n",
    "\n",
    "for i in set(tup1):\n",
    "    for j in set(tup2):\n",
    "       if i == j :\n",
    "          print(i)"
   ]
  }
