   "source": [
    "7. Write a program to find the intersection of two tuples."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "ddf9d0cf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " Intersection: 2 3 6 7 "
     ]
    }
   ],
   "source": [
    "tup1 = (2, 3, 4, 7, 9 ,4 ,6)\n",
    "tup2 = (2, 8, 6, 0, 1, 3, 7)\n",
    "\n",
    "print(\" Intersection:\", end = \" \")\n",
    "\n",
    "for i in set(tup1):\n",
    "    for j in set(tup2):\n",
    "       if i == j :\n",
    "          print(i, end = \" \")"
   ]
  }
