   "source": [
    "9. Write a program to convert a nested tuple like:\n",
    "Input - ((1,2), (3,4), (5,6))\n",
    "into:\n",
    "output -(1,2,3,4,5,6)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "a6731f41",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(1, 2, 3, 4, 5, 6)\n"
     ]
    }
   ],
   "source": [
    "tup1 = ((1,2), (3,4), (5,6))\n",
    "tup2 = ()\n",
    "\n",
    "for i in tup1:\n",
    "    tup2 += i\n",
    "print(tup2)\n",
    "\n"
   ]
  }
 ],
